{
  "name": "veridian-backend",
  "version": "1.0.0",
  "description": "API backend pour Veridian",
  "type": "module",
  "main": "server.js",
  "directories": {
    "test": "tests"
  },
"scripts": {
  "dev": "nodemon server.js",
  "start": "node server.js",
  "test": "dotenv -e .env.test -- node --experimental-vm-modules node_modules/.bin/jest --runInBand",
  "test:watch": "dotenv -e .env.test -- node --experimental-vm-modules node_modules/.bin/jest --watch --runInBand"
},
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "verbose": true
  },
  "keywords": [],
  "author": "Francis Cote",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "dotenv-cli": "^11.0.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
