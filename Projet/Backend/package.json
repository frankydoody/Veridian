{
  "name": "veridian-backend",
  "version": "1.0.0",
  "description": "API backend pour Veridian",
  "type": "module",
  "main": "server.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --selectProjects unit",
    "test:api": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --selectProjects api",
    "test:all": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --coverage",
    "test:db": "node database/preparer-base-test.mjs",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --watch --selectProjects unit",
    "verifier": "node scripts/verifier.js"
  },
  "jest": {
    "verbose": true,
    "projects": [
      {
        "displayName": "unit",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/tests/unit/**/*.test.js"
        ],
        "setupFiles": [
          "<rootDir>/tests/setup-env.js"
        ]
      },
      {
        "displayName": "api",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/tests/api/**/*.test.js"
        ],
        "setupFiles": [
          "<rootDir>/tests/api/setup-env.js"
        ],
        "globalSetup": "<rootDir>/tests/api/global-setup.js"
      }
    ],
    "collectCoverageFrom": [
      "app.js",
      "src/**/*.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "text-summary",
      "html"
    ]
  },
  "keywords": [],
  "author": "Francis Cote",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "nodemailer": "^7.0.13",
    "pdfkit": "^0.17.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
