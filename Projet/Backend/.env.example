# Copier ce fichier en .env (start.ps1 / start.sh le font automatiquement).
PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=veridian
DB_USER=veridian_user
DB_PASSWORD=veridian_pass

# Genere automatiquement par le script de demarrage si vide
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Cle gratuite : https://aistudio.google.com/apikey
GEMINI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash

WHISPER_MODE=local
WHISPER_MODEL=small
WHISPER_LANGUAGE=fr

# Courriels (bloc 19). Sans SMTP_HOST : mode console, aucun courriel reel n'est envoye.
# Exemple avec Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=vous@gmail.com,
# SMTP_PASSWORD=mot_de_passe_d_application
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Veridian <no-reply@veridian.local>

# Enregistrements audio (bloc 20)
# Taille maximale d'un fichier audio envoye, en Mo
MAX_AUDIO_MB=200
# Duree maximale d'une transcription Whisper, en minutes (au-dela, elle est arretee)
WHISPER_TIMEOUT_MIN=30
# Chemin complet de whisper ou ffmpeg s'ils ne sont pas dans le PATH (laisser vide sinon)
WHISPER_COMMAND=
FFMPEG_COMMAND=

# Securite (bloc 17)
# Adresse(s) du frontend autorisees a appeler l'API (CORS), separees par des virgules
FRONTEND_URL=http://localhost:5173
# Connexion et inscription : nombre d'essais permis par adresse IP et par fenetre de N minutes
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_MIN=15
