# Configuration du backend Veridian.
# Copier ce fichier en .env (start.ps1 / start.sh le font automatiquement et completent
# les valeurs manquantes). Ne jamais committer le fichier .env : il contient des secrets.
# Verifier une installation : npm run verifier (ou .\start.ps1 -Verifier / ./start.sh --verifier)

# --- Serveur ---------------------------------------------------------------
# Port de l'API (le frontend Vite redirige /api vers ce port)
PORT=3000
# development ou production
NODE_ENV=development

# --- Base de donnees (doit correspondre a docker-compose.yml) --------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=veridian
DB_USER=veridian_user
DB_PASSWORD=veridian_pass

# --- Authentification ------------------------------------------------------
# Secret de signature des jetons (32 caracteres minimum, sinon le serveur refuse de demarrer).
# Genere automatiquement par le script de demarrage s'il est vide.
JWT_SECRET=
# Duree de validite d'une session (ex. 7d, 12h)
JWT_EXPIRES_IN=7d

# --- Intelligence artificielle (Gemini) ------------------------------------
# Cle gratuite : https://aistudio.google.com/apikey (utiliser une cle dediee au projet,
# revocable apres usage)
GEMINI_API_KEY=
# Modele principal ; en cas d'indisponibilite, l'application essaie gemini-flash-latest
# puis gemini-flash-lite-latest. gemini-2.5-flash n'est plus offert aux nouveaux comptes.
AI_MODEL=gemini-3.5-flash
# Modele d'embeddings de la memoire (vecteurs de 768 dimensions, ne pas changer sans
# adapter la base)
EMBED_MODEL=gemini-embedding-001

# --- Transcription (Whisper local) -----------------------------------------
# Modele Whisper : tiny, base, small (defaut, bon compromis), medium, large
WHISPER_MODEL=small
# Langue des reunions
WHISPER_LANGUAGE=fr
# Duree maximale d'une transcription, en minutes (au-dela, elle est arretee)
WHISPER_TIMEOUT_MIN=30
# Chemin complet de whisper ou ffmpeg s'ils ne sont pas dans le PATH (laisser vide sinon)
WHISPER_COMMAND=
FFMPEG_COMMAND=

# --- Enregistrements audio -------------------------------------------------
# Taille maximale d'un fichier audio envoye, en Mo
MAX_AUDIO_MB=200
# Dossier des fichiers audio, relatif a src/config (vide = dossier uploads a la racine du depot)
UPLOAD_DIR=

# --- Courriels (SMTP) ------------------------------------------------------
# Par defaut : boite de test locale Mailpit (conteneur veridian_mail de docker-compose.yml).
# Les courriels partent vraiment par SMTP mais restent sur ce PC ; on les lit sur MAILBOX_URL
# (lien "Boite courriel de test" dans l'en-tete de l'application).
# Pour de vrais envois, remplacer par un serveur reel et vider MAILBOX_URL. Gmail :
# SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false, SMTP_USER=adresse@gmail.com,
# SMTP_PASSWORD=mot de passe d'application (https://myaccount.google.com/apppasswords),
# jamais le mot de passe personnel du compte.
# SMTP_HOST vide : mode console (courriels affiches dans la console du backend seulement).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# true pour le port 465 (SSL direct), false pour 587 (STARTTLS) et pour Mailpit
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Expediteur affiche (avec Gmail, utiliser l'adresse de SMTP_USER)
MAIL_FROM=Veridian <no-reply@veridian.local>
# Adresse de la boite courriel de test (vide avec un SMTP reel)
MAILBOX_URL=http://localhost:8025

# --- Securite --------------------------------------------------------------
# Adresse(s) du frontend autorisees a appeler l'API (CORS), separees par des virgules
FRONTEND_URL=http://localhost:5173
# Connexion et inscription : nombre d'essais permis par adresse IP et par fenetre de N minutes
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_MIN=15
