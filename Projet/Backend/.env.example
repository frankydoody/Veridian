# Copier ce fichier en .env (start.ps1 / start.sh le font automatiquement).
PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=veridian
DB_USER=veridian_user
DB_PASSWORD=veridian_pass

# Genere automatiquement par le script de demarrage si vide
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Cle gratuite : https://aistudio.google.com/apikey
GEMINI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash

WHISPER_MODE=local
WHISPER_MODEL=small
WHISPER_LANGUAGE=fr
